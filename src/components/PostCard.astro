---
import type { CollectionEntry } from "astro:content";

const { post } = Astro.props as { post: CollectionEntry<"posts"> };

const url = `/posts/${post.slug}/`;
const title = post.data.title;
const desc = post.data.description ?? "";
const date = post.data.pubDate;
const category = post.data.category;
const hero = post.data.heroImage;
---

<article class="card">
  <a class="thumb" href={url} aria-label={title}>
    {hero ? (
      <img src={hero.src} alt="" loading="lazy" />
    ) : (
      <div class="placeholder" aria-hidden="true"></div>
    )}
  </a>

  <div class="body">
    <div class="meta">
      <span class="cat">{category}</span>
      <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
    </div>
    <h2 class="title"><a href={url}>{title}</a></h2>
    {desc && <p class="desc">{desc}</p>}
  </div>
</article>

<style>
  .card {
    border: 1px solid rgba(127,127,127,0.25);
    border-radius: 16px;
    overflow: hidden;
    background: rgba(127,127,127,0.06);
  }
  .thumb { display: block; height: 160px; background: rgba(127,127,127,0.10); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, rgba(127,127,127,0.12), rgba(127,127,127,0.05)); }
  .body { padding: 14px 14px 16px; }
  .meta { display: flex; gap: 10px; justify-content: space-between; opacity: 0.8; font-size: 0.9rem; }
  .title { margin: 10px 0 6px; font-size: 1.1rem; }
  .title a { text-decoration: none; }
  .title a:hover { text-decoration: underline; }
  .desc { margin: 0; opacity: 0.9; }
</style>

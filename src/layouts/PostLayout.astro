---
const {
  title,
  pubDate,
  category,
  sidebarCategories,
} = Astro.props as {
  title: string;
  pubDate: Date;
  category: string;
  sidebarCategories: string[];
};
---

<article class="post">
  <header class="head">
    <div class="meta">
      <span class="cat">{category}</span>
      <time datetime={pubDate.toISOString()}>{pubDate.toISOString().slice(0, 10)}</time>
    </div>
    <h1>{title}</h1>
  </header>

  <div class="content">
    <slot />
  </div>

  <section class="after" aria-label="After content">
    <div class="afterInner">
      <div class="afterGrid">
        <div class="panel">
          <div class="panelTitle">categories</div>
          <ul class="list">
            <li><a href="/categories/">all</a></li>
            {sidebarCategories.map((c) => (
              <li><a href={`/categories/${c}/`}>{c}</a></li>
            ))}
          </ul>
        </div>

        <div class="panel">
          <div class="panelTitle">related</div>
          <slot name="related" />
          <div class="hint">記事本文とは切り離された導線</div>
        </div>
      </div>
    </div>
  </section>
</article>

<style>
  /* --- One column centered --- */
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 0 56px;
    min-width: 0;
  }

  .head {
    margin-bottom: 18px;
  }

  .meta {
    display: flex;
    gap: 10px;
    justify-content: space-between;
    color: rgba(17, 17, 17, 0.65);
    font-size: 0.95rem;
  }

  h1 {
    margin: 10px 0 0;
    font-size: 2.2rem;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }

  /* --- Typography (note-like) --- */
  .content :global(p) {
    margin: 0 0 1.15em;
    font-size: 1.03rem;
    line-height: 1.95;
  }

  .content :global(h2) {
    margin: 1.9em 0 0.75em;
    font-size: 1.55rem;
    line-height: 1.35;
  }

  .content :global(h3) {
    margin: 1.6em 0 0.6em;
    font-size: 1.22rem;
    line-height: 1.45;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1.1em 1.35em;
  }

  .content :global(li) {
    margin: 0.35em 0;
  }

  .content :global(blockquote) {
    margin: 1.2em 0;
    padding: 0.2em 0 0.2em 1em;
    border-left: 3px solid rgba(17, 17, 17, 0.18);
    color: rgba(17, 17, 17, 0.82);
  }

  .content :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      "Courier New", monospace;
    font-size: 0.95em;
    background: rgba(17, 17, 17, 0.06);
    padding: 0.15em 0.35em;
    border-radius: 6px;
  }

  .content :global(pre) {
    background: rgba(17, 17, 17, 0.06);
    padding: 14px;
    border-radius: 12px;
    overflow: auto;
    margin: 1.2em 0;
  }

  .content :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .content :global(hr) {
    border: 0;
    border-top: 1px solid rgba(17, 17, 17, 0.12);
    margin: 2em 0;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 14px;
    display: block;
    margin: 1.2em 0;
  }

  /* --- After section (comment-like separation) --- */
  .after {
    margin-top: 44px;
    padding-top: 26px;
    border-top: 1px solid rgba(17, 17, 17, 0.12);
  }

  .afterInner {
    background: rgba(17, 17, 17, 0.03);
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: 18px;
    padding: 18px;
  }

  .afterGrid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 16px;
    align-items: start;
  }

  .panelTitle {
    color: rgba(17, 17, 17, 0.65);
    margin-bottom: 10px;
    font-size: 0.95rem;
  }

  .panel {
    background: #fff;
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: 14px;
    padding: 14px;
    min-width: 0;
  }

  .list {
    margin: 0;
    padding-left: 18px;
  }

  .list li {
    margin: 6px 0;
  }

  .hint {
    margin-top: 10px;
    color: rgba(17, 17, 17, 0.55);
    font-size: 0.9rem;
  }

  /* --- Mobile --- */
  @media (max-width: 780px) {
    .post {
      max-width: 100%;
      padding: 0 0 44px;
    }

    h1 {
      font-size: 1.9rem;
    }

    .afterGrid {
      grid-template-columns: 1fr;
    }
  }
</style>
